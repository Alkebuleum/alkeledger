rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ──────────────────────────────────────────────────────────────

    function membershipDoc(orgId) {
      return get(/databases/$(database)/documents/memberships/$(orgId + '_' + request.auth.uid));
    }

    function isMemberOfOrg(orgId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/memberships/$(orgId + '_' + request.auth.uid)) &&
        membershipDoc(orgId).data.status == 'active';
    }

    function isPendingOrActiveMember(orgId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/memberships/$(orgId + '_' + request.auth.uid));
    }

    function orgRole(orgId) {
      return membershipDoc(orgId).data.role;
    }

    function canManage(orgId) {
      return isMemberOfOrg(orgId) && orgRole(orgId) in ['owner', 'admin', 'treasurer'];
    }

    function canApprove(orgId) {
      return isMemberOfOrg(orgId) && orgRole(orgId) in ['owner', 'admin', 'treasurer', 'auditor'];
    }

    // ─── users (profile docs) ─────────────────────────────────────────────────

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── memberships ──────────────────────────────────────────────────────────
    // Key: {orgId}_{userId}  Fields: orgId, userId, role, status, name, email…

    match /memberships/{membershipId} {
      // LIST (collection query):
      //   - own memberships:  where('userId', '==', uid)
      //   - org members list: where('orgId', '==', orgId)  — only if caller is member
      allow list: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isMemberOfOrg(resource.data.orgId)
      );

      // GET (single document read)
      allow get: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isMemberOfOrg(resource.data.orgId)
      );

      // CREATE: user creates their own membership (join via invite code → pending)
      //         OR owner bootstrapping (status active, role owner) right after org creation
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // UPDATE: admins manage members; users can update own non-sensitive fields
      allow update: if request.auth != null && (
        canManage(resource.data.orgId) ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.orgId == resource.data.orgId)
      );

      allow delete: if request.auth != null && canManage(resource.data.orgId);
    }

    // ─── invite tokens ────────────────────────────────────────────────────────

    match /invites/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && canManage(request.resource.data.orgId);
      allow delete: if request.auth != null && canManage(resource.data.orgId);
    }

    // ─── OTP codes (written by Cloud Function via Admin SDK, read never needed client-side) ───

    match /otpCodes/{email} {
      allow read, write: if false;
    }

    // ─── organizations ────────────────────────────────────────────────────────

    match /organizations/{orgId} {
      // Pending members can read org info (needed to show org name after join request)
      allow read: if isPendingOrActiveMember(orgId);
      // Any authenticated user can create an org (they become owner via membership write)
      allow create: if request.auth != null;
      allow update: if isMemberOfOrg(orgId) && orgRole(orgId) in ['owner', 'admin'];
      allow delete: if isMemberOfOrg(orgId) && orgRole(orgId) == 'owner';

      match /ledgerEntries/{entryId} {
        allow read: if isMemberOfOrg(orgId);
        allow create: if canManage(orgId);
        allow update: if canApprove(orgId) ||
          (canManage(orgId) &&
           resource.data.createdByUid == request.auth.uid &&
           resource.data.status == 'draft');
        allow delete: if canManage(orgId) && resource.data.status == 'draft';
      }

      match /projects/{projectId} {
        allow read: if isMemberOfOrg(orgId);
        allow write: if canManage(orgId);
      }

      match /documents/{docId} {
        allow read: if isMemberOfOrg(orgId);
        allow write: if canManage(orgId);
      }

      match /announcements/{annId} {
        allow read: if isMemberOfOrg(orgId);
        allow write: if canManage(orgId);
      }

      match /requests/{reqId} {
        allow read: if isMemberOfOrg(orgId);
        allow create: if isMemberOfOrg(orgId);
        allow update: if canManage(orgId);
        allow delete: if canManage(orgId) ||
          (isMemberOfOrg(orgId) &&
           resource.data.fromId == request.auth.uid &&
           resource.data.status == 'open');
      }

      match /auditLogs/{logId} {
        allow read: if isMemberOfOrg(orgId);
        allow create: if isMemberOfOrg(orgId);
        allow update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if isMemberOfOrg(orgId);
        allow write: if canApprove(orgId);
      }

      match /anchors/{anchorId} {
        allow read: if isMemberOfOrg(orgId);
        allow write: if canApprove(orgId);
      }
    }

    // ─── public transparency pages ────────────────────────────────────────────

    match /public/{orgId} {
      allow read: if true;
      allow write: if request.auth != null &&
        isMemberOfOrg(orgId) && orgRole(orgId) in ['owner', 'admin'];
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ──────────────────────────────────────────────────────────────

    function membershipDoc(orgId) {
      return get(/databases/$(database)/documents/memberships/$(orgId + '_' + request.auth.uid));
    }

    function isMemberOfOrg(orgId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/memberships/$(orgId + '_' + request.auth.uid)) &&
        membershipDoc(orgId).data.status == 'active';
    }

    function isPendingOrActiveMember(orgId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/memberships/$(orgId + '_' + request.auth.uid));
    }

    function orgRole(orgId) {
      return membershipDoc(orgId).data.role;
    }

    function canManage(orgId) {
      return isMemberOfOrg(orgId) && orgRole(orgId) in ['owner', 'admin', 'treasurer'];
    }

    function canApprove(orgId) {
      return isMemberOfOrg(orgId) && orgRole(orgId) in ['owner', 'admin', 'treasurer', 'auditor'];
    }

    // ─── users (profile docs) ─────────────────────────────────────────────────

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /notifications/{notifId} {
        // Users can read their own notifications and mark them read; only Admin SDK can create/delete
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ─── memberships ──────────────────────────────────────────────────────────
    // Key: {orgId}_{userId}  Fields: orgId, userId, role, status, name, email…

    match /memberships/{membershipId} {
      // LIST (collection query):
      //   - own memberships:  where('userId', '==', uid)
      //   - org members list: where('orgId', '==', orgId)  — only if caller is member
      allow list: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isMemberOfOrg(resource.data.orgId)
      );

      // GET (single document read)
      // resource == null when the document doesn't exist; allow so callers can
      // check existence before creating (joinOrganization duplicate check).
      allow get: if request.auth != null && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isMemberOfOrg(resource.data.orgId)
      );

      // CREATE: user creates their own membership (join via invite code → pending)
      //         OR owner bootstrapping (status active, role owner) right after org creation
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // UPDATE: admins manage members; users can update own non-sensitive fields
      allow update: if request.auth != null && (
        canManage(resource.data.orgId) ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.orgId == resource.data.orgId)
      );

      allow delete: if request.auth != null && canManage(resource.data.orgId);
    }

    // ─── invite tokens ────────────────────────────────────────────────────────

    match /invites/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && canManage(request.resource.data.orgId);
      allow delete: if request.auth != null && canManage(resource.data.orgId);
    }

    // ─── OTP codes (written by Cloud Function via Admin SDK, read never needed client-side) ───

    match /otpCodes/{email} {
      allow read, write: if false;
    }

    // ─── organizations ────────────────────────────────────────────────────────

    match /organizations/{orgId} {
      // Any authenticated user can read org metadata (name, type, slug, inviteCode, etc.).
      // This is needed so a new user can look up an org by invite code before joining.
      // Sensitive data (ledger, members, etc.) lives in subcollections with their own rules.
      allow read: if request.auth != null;
      // Any authenticated user can create an org (they become owner via membership write)
      allow create: if request.auth != null;
      allow update: if isMemberOfOrg(orgId) && orgRole(orgId) in ['owner', 'admin'];
      allow delete: if isMemberOfOrg(orgId) && orgRole(orgId) == 'owner';

      match /ledgerEntries/{entryId} {
        allow read: if isMemberOfOrg(orgId);
        // Admins/treasurers can create any entry; members can self-submit a pending dues entry
        allow create: if canManage(orgId) ||
          (isMemberOfOrg(orgId) &&
           request.resource.data.status == 'pending' &&
           request.resource.data.category == 'Dues' &&
           request.resource.data.createdByUid == request.auth.uid);
        allow update: if canApprove(orgId) ||
          (canManage(orgId) &&
           resource.data.createdByUid == request.auth.uid &&
           resource.data.status == 'draft');
        allow delete: if canManage(orgId) && resource.data.status == 'draft';
      }

      match /projects/{projectId} {
        allow read: if isMemberOfOrg(orgId);
        allow write: if canManage(orgId);
      }

      match /documents/{docId} {
        allow read: if isMemberOfOrg(orgId);
        allow create: if canManage(orgId);
        allow update: if canManage(orgId);
        allow delete: if canManage(orgId);
      }

      match /requests/{reqId} {
        allow read: if isMemberOfOrg(orgId);
        allow create: if isMemberOfOrg(orgId);
        allow update: if canManage(orgId);
        allow delete: if canManage(orgId) ||
          (isMemberOfOrg(orgId) &&
           resource.data.fromId == request.auth.uid &&
           resource.data.status == 'open');
      }

      match /auditLogs/{logId} {
        allow read: if isMemberOfOrg(orgId);
        allow create: if isMemberOfOrg(orgId);
        allow update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if isMemberOfOrg(orgId);
        allow write: if canApprove(orgId);
      }

      match /anchors/{anchorId} {
        allow read: if isMemberOfOrg(orgId);
        allow write: if canApprove(orgId);
      }

      match /duesPeriods/{periodId} {
        allow read: if isMemberOfOrg(orgId);
        allow create: if canManage(orgId);
        allow update: if canManage(orgId);
        allow delete: if canManage(orgId);
      }

      match /benefits/{benefitId} {
        allow read: if isMemberOfOrg(orgId);
        allow create, update, delete: if canManage(orgId);
      }

      match /positions/{positionId} {
        allow read: if isMemberOfOrg(orgId);
        allow create, update, delete: if canManage(orgId);
      }

      match /benefitRequests/{reqId} {
        // Admins see all; members see only their own
        allow read: if canManage(orgId) ||
          (isMemberOfOrg(orgId) && resource.data.memberId == request.auth.uid);
        // Members can submit for themselves; must be pending on create
        allow create: if isMemberOfOrg(orgId) &&
          request.resource.data.memberId == request.auth.uid &&
          request.resource.data.status == 'pending';
        // Only admins can approve/reject
        allow update, delete: if canManage(orgId);
      }

      match /events/{eventId} {
        allow read: if isMemberOfOrg(orgId);
        allow create: if canManage(orgId);
        allow delete: if canManage(orgId);
        // Admins can edit anything; members can only update their own RSVP entry
        allow update: if canManage(orgId) ||
          (isMemberOfOrg(orgId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvps']));
      }

      match /polls/{pollId} {
        allow read: if isMemberOfOrg(orgId);
        allow create: if canManage(orgId);
        allow delete: if canManage(orgId);
        // Admins can edit anything; members can only update their own vote entry
        allow update: if canManage(orgId) ||
          (isMemberOfOrg(orgId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']));
      }
    }

    // ─── public transparency pages ────────────────────────────────────────────

    match /public/{orgId} {
      allow read: if true;
      allow write: if request.auth != null &&
        isMemberOfOrg(orgId) && orgRole(orgId) in ['owner', 'admin'];
    }
  }
}

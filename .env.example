# Firebase configuration — copy this to `.env.local` and fill in real values
# Get these from your Firebase console: Project settings → Your apps → SDK setup

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to bypass Firebase entirely and use in-memory mock data
# Useful for local development without a Firebase project
VITE_USE_MOCK_DATA=true

# Alkebuleum anchoring endpoint (Stage 5 placeholder)
VITE_ANCHOR_ENDPOINT=

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Org membership lookup against Firestore (mirrors firestore.rules' isMemberOfOrg,
    // active members only — pending/rejected members get no file access).
    function isOrgMember(orgId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/memberships/$(orgId + '_' + request.auth.uid)).data.status == 'active';
    }

    // Receipts: organized as receipts/{orgId}/{entryId}/{filename}
    match /receipts/{orgId}/{entryId}/{filename} {
      allow read: if isOrgMember(orgId);
      allow write: if isOrgMember(orgId) &&
        request.resource.size < 10 * 1024 * 1024 &&  // 10MB cap
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Documents: documents/{orgId}/{docId}/{filename}
    match /documents/{orgId}/{docId}/{filename} {
      allow read: if isOrgMember(orgId);
      // request.resource is null on delete, so it must be its own rule —
      // folding it into `allow write`'s size/type checks denies every delete
      allow create, update: if isOrgMember(orgId) &&
        request.resource.size < 25 * 1024 * 1024;  // 25MB cap
      allow delete: if isOrgMember(orgId);
    }

    // Ledger documents (anchorable evidence, e.g. ID cards): ledger-documents/{orgId}/{docId}/{filename}
    match /ledger-documents/{orgId}/{docId}/{filename} {
      allow read: if isOrgMember(orgId);
      allow write: if isOrgMember(orgId) &&
        request.resource.size < 10 * 1024 * 1024 &&  // 10MB cap
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Event cover images: event-images/{orgId}/{imageId}/{filename}
    match /event-images/{orgId}/{imageId}/{filename} {
      allow read: if isOrgMember(orgId);
      // request.resource is null on delete, so it must be its own rule —
      // folding it into `allow write`'s size/type checks denies every delete
      allow create, update: if isOrgMember(orgId) &&
        request.resource.size < 5 * 1024 * 1024 &&  // 5MB cap
        request.resource.contentType.matches('image/.*');
      allow delete: if isOrgMember(orgId);
    }

    // Org logos: logos/{orgId}/{filename} — publicly readable branding assets
    match /logos/{orgId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
